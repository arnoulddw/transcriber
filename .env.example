# ./.env.example
# Example environment variables file.
# Copy this to .env and fill in your actual values.

# -------------------------------------
# --- Core Application Settings ---
# -------------------------------------
# !! CRITICAL: Generate a strong, random secret key for session security and encryption !!
# Use a command like: openssl rand -hex 32 OR python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=generate_a_strong_random_32_byte_hex_key_here

# Personal or team mode. Leave unset to start in personal mode and switch in
# the app (User Settings > Access). Setting it locks the switch in the app.
# 'single': personal mode. One owner account, sign-in optional, no Admin panel.
# 'multi':  team mode. Sign-up, Google sign-in, password resets, Admin panel.
# DEPLOYMENT_MODE=

# Team mode sign-ups. Leave unset to control it in the app; 'true'/'false' locks it.
# ALLOW_REGISTRATION=

# Cookies are marked Secure automatically on HTTPS requests. Set 'true' to
# always mark them Secure (only if the app is never reached over plain HTTP).
# SESSION_COOKIE_SECURE=false

# Set your preferred timezone (e.g., "UTC", "Europe/London", "America/New_York")
TZ=UTC

# Port the Flask app will be exposed on the host by Docker
APP_PORT=5004

# -------------------------------------
# --- API Keys (Global Fallbacks / Single-User Mode) ---
# -------------------------------------
# These are used globally in 'single' user mode.
# In 'multi' user mode, they serve as fallbacks if a user hasn't set their own.
ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_API_KEY_HERE # Used for AssemblyAI transcription
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE # Used for OpenAI transcription and LLM models
LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Comma-separated Live models. Vendor/model slugs use OpenRouter's SSE audio
# path; slashless models continue to use OpenAI WebRTC.
# LIVE_TRANSCRIPTION_MODELS=gpt-live-transcribe,openai/gpt-transcribe
# LIVE_TRANSCRIPTION_PROVIDER_OPENAI_GPT_TRANSCRIBE=openrouter
# Optional explicit additions when OpenRouter publishes a new STT model.
# OPENROUTER_LIVE_TRANSCRIPTION_MODELS=vendor/model
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE # Used for Gemini LLM
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE # Placeholder for future Anthropic LLM

# -------------------------------------
# --- Provider & Language Configuration ---
# -------------------------------------
# Fixed transcription providers the app can talk to. Models are NOT seeded:
# each model becomes available when an API key for it is saved in the app
# (Manage API Keys), e.g. whisper-1, gpt-4o-transcribe, gpt-transcribe.
TRANSCRIPTION_PROVIDERS=assemblyai,openai,gemini,openrouter
# Default provider if not specified by user (must be in TRANSCRIPTION_PROVIDERS)
DEFAULT_TRANSCRIPTION_PROVIDER=openai
# --- LLM Provider & Model Configuration ---
# DEFAULT_LLM_PROVIDER: "GEMINI", "OPENAI", or "OPENROUTER". Determines the fallback API.
DEFAULT_LLM_PROVIDER=GEMINI
# LLM_MODEL: The specific model to use (e.g., "gemini-3.0-flash").
LLM_MODEL=gemini-3.0-flash
# Default model for workflow prompts when a user has no saved preference.
WORKFLOW_LLM_PROVIDER=OPENROUTER
WORKFLOW_LLM_MODEL=google/gemini-3.7-flash
# Default model for auxiliary LLM tasks such as title generation.
TITLE_GENERATION_LLM_PROVIDER=GEMINI
TITLE_GENERATION_LLM_MODEL=gemma-4-26b-a4b-it
# Default language for transcription (e.g., "auto", "en", "es")
DEFAULT_LANGUAGE=auto
# Comma-separated list of supported language codes for the UI dropdown
SUPPORTED_LANGUAGE_CODES=en,nl,fr,es

# -------------------------------------
# --- MySQL Database Configuration ---
# -------------------------------------
MYSQL_HOST=mysql # Service name in docker-compose.yml for the app to connect to
MYSQL_PORT=3306  # Internal port the MySQL service listens on
MYSQL_USER=transcriber_user
MYSQL_PASSWORD=YOUR_STRONG_MYSQL_PASSWORD_HERE # Password for the 'transcriber_user'
MYSQL_DB=transcriber_db
MYSQL_ROOT_PASSWORD=YOUR_STRONG_MYSQL_ROOT_PASSWORD_HERE # Root password for the MySQL service itself
MYSQL_HOST_PORT=3307 # Port on the HOST machine to map to MySQL's internal port (for external access if needed)
# Database connection pool size
MYSQL_POOL_SIZE=10

# -------------------------------------
# --- Owner account (created on first start) ---
# -------------------------------------
# All optional in personal mode. Without ADMIN_PASSWORD the app opens without a
# login; you can add a password later in User Settings > Access.
# Setting ADMIN_PASSWORD turns sign-in on and stops it being turned off in the app.
# Team mode (DEPLOYMENT_MODE=multi) on a fresh install needs ADMIN_PASSWORD.
# Forgot the password? Run: docker compose exec transcriber flask reset-owner-password
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=you@example.com

# -------------------------------------
# --- Email Configuration (for Password Recovery etc.) ---
# -------------------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email_username@example.com
MAIL_PASSWORD=your_email_password_or_app_password
MAIL_DEFAULT_SENDER="Transcriber <noreply@example.com>"
MAIL_DEBUG=false # Set to true for verbose Flask-Mail logs

# -------------------------------------
# --- OAuth Configuration ---
# -------------------------------------
# Required for "Sign in with Google" feature in 'multi' mode
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_FOR_WEB_APP.apps.googleusercontent.com

# -------------------------------------
# --- Workflow Configuration ---
# -------------------------------------
# Maximum number of tokens the LLM should generate in a workflow response
WORKFLOW_MAX_OUTPUT_TOKENS=1024
# Rate limit specifically for workflow API calls (example: "10 per hour" per user)
WORKFLOW_RATE_LIMIT="10 per hour"
# Extra process-local limit for the direct LLM endpoint; MySQL workflow quotas remain authoritative.
DIRECT_LLM_RATE_LIMIT="5 per hour"

# -------------------------------------
# --- File Storage & Data Retention ---
# -------------------------------------
# Time in seconds after which temporary uploaded files are deleted (default: 86400 = 24 hours)
DELETE_THRESHOLD=86400
# Number of days after a record is soft-deleted (hidden) before it's physically deleted from the database
PHYSICAL_DELETION_DAYS=120

# -------------------------------------
# --- Logging & Security ---
# -------------------------------------
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Complexity for password hashing (default: 12)
BCRYPT_LOG_ROUNDS=12
# Default rate limits for Flask-Limiter (applied to most non-auth routes)
RATELIMIT_DEFAULT="200 per day;50 per hour"
# RATELIMIT_STORAGE_URI="memory://" # Default in config.py, consider Redis for production

# -------------------------------------
# --- reCAPTCHA v3 ---
# -------------------------------------
# Obtain keys from https://www.google.com/recaptcha/admin/create (v3 type)
RECAPTCHA_V3_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
RECAPTCHA_V3_SECRET_KEY=YOUR_RECAPTCHA_V3_SECRET_KEY
# Optional overrides (defaults shown)
RECAPTCHA_V3_LOGIN_ACTION=login
RECAPTCHA_V3_LOGIN_THRESHOLD=0.5
# Enterprise-only settings (set both to enable enterprise mode)
RECAPTCHA_ENTERPRISE_PROJECT_ID=YOUR_GCP_PROJECT_ID
RECAPTCHA_ENTERPRISE_API_KEY=YOUR_RECAPTCHA_ENTERPRISE_API_KEY

# -------------------------------------
# --- Transcription Performance ---
# -------------------------------------
# Number of parallel workers for chunked transcription (OpenAI models). AssemblyAI uses 1.
TRANSCRIPTION_WORKERS=4
# Total simultaneous background jobs in the dedicated worker process.
TRANSCRIPTION_MAX_CONCURRENT_JOBS=2
BACKGROUND_WORKER_CONCURRENCY=2
# Seconds between durable queue polls.
BACKGROUND_JOB_POLL_SECONDS=1
# Maximum attempts for a job, including the first claim.
BACKGROUND_JOB_MAX_ATTEMPTS=3
# Maximum exponential retry delay.
BACKGROUND_JOB_RETRY_DELAY_MAX_SECONDS=300
# Running claims older than this are recovered by a worker.
BACKGROUND_JOB_STALE_SECONDS=300
# Days to retain succeeded and permanently failed queue rows for diagnostics.
BACKGROUND_JOB_RETENTION_DAYS=30
# Maximum terminal queue rows removed per cleanup cycle.
BACKGROUND_JOB_PURGE_BATCH_SIZE=1000
